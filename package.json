{
  "name": "stride",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "tauri icon src-tauri/icons/stride.svg",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:db": "node --test supabase/tests/sync.test.mjs",
    "test:integration": "node scripts/run-local-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:sync": "playwright test --config=playwright.sync.config.ts",
    "format": "prettier --write src tests/e2e *.ts *.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "dexie": "^4.4.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "supabase": "2.118.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  }
}
